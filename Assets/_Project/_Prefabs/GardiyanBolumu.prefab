  m_Script: {fileID: 11500000, guid: af586006801352b4090fe3bc7af53516, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::CastleRescue.NPC.GuardNPC
  llmClientComponent: {fileID: 0}
  guardName: Gardiyan Hugo
  persona: "Sen Kuzgun Kalesi'nin ya\u015Fl\u0131 zindan gardiyan\u0131 Hugo'sun. Otuz y\u0131ld\u0131r ayn\u0131 kap\u0131da n\xF6bet tutuyorsun. Prensesin hapsedildi\u011Fi kuleye a\xE7\u0131lan kap\u0131n\u0131n anahtar\u0131 sende. Kral'a sad\u0131ks\u0131n ama \xE7ok yorgunsun. Zaaflar\u0131n: alt\u0131n, iyi \u015Farap ve emekli olup k\xF6y\xFCne d\xF6nme hayali. Prensese i\xE7ten i\xE7e ac\u0131yorsun. En b\xFCy\xFCk korkun Kral'\u0131n \xF6fkesi ve zindana at\u0131lmak. Huysuz ama \xF6z\xFCnde iyi kalpli birisin."
  openingLine: "Dur orada yabanc\u0131! Bu kap\u0131dan Kral'\u0131n izni olmadan kimse ge\xE7emez. Ne istiyorsun?"
  startingTrust: 30
  keyTrustThreshold: 55
  autoKeyTrust: 80
  maxTrustChangePerTurn: 25
  maxHistoryMessages: 10
