  m_GameObject: {fileID: 794344131569716019}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 15ce143dc3c518f41bbfe9868832b0de, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::CastleRescue.World.PrincessCage
  cageDoor: {fileID: 4448957175054076536}
  endingUI: {fileID: 0}
  interactDistance: 2.5
  delayBeforeDialogue: 1.5
  endingLines:
  - speaker: Prenses
    text: "Sonunda biri geldi! Seni Kral'\u0131n adamlar\u0131 m\u0131 g\xF6nderdi?"
  - speaker: Sen
    text: "Hay\u0131r, kendi iste\u011Fimle geldim. Seni buradan \xE7\u0131karaca\u011F\u0131m."
  - speaker: Prenses
    text: "Peki ya \u015Fu aya\u011F\u0131n\u0131n dibindeki k\xFC\xE7\xFCk dostun? O bir fare mi?"
  - speaker: Fare
    text: Cik! Cik cik!
  - speaker: Sen
    text: "Onun yard\u0131m\u0131 olmasayd\u0131 avludaki \u015Falteri asla indiremezdim."
  - speaker: Prenses
    text: "O halde ikinize de bor\xE7luyum. Hadi, g\xFCn do\u011Fmadan bu kaleden \xE7\u0131kal\u0131m!"
